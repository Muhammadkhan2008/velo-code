{
  "name": "velo-code-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:build:win": "electron-builder --win nsis --publish never",
    "desktop:build:linux": "electron-builder --linux AppImage --publish never",
    "desktop:build:mac": "electron-builder --mac dmg --publish never",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios"
  },
  "dependencies": {
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.26.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@babel/generator": "7.29.1",
    "@capacitor/android": "^7.3.0",
    "@capacitor/cli": "^7.3.0",
    "@capacitor/core": "^7.3.0",
    "@capacitor/ios": "^7.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "enhanced-resolve": "^5.20.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "build": {
    "appId": "com.velocode.app",
    "productName": "Velo Code",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
