# AI_PROVIDER: auto | openrouter | gemini
# auto will prefer OPENROUTER_API_KEY if present, otherwise GEMINI_API_KEY.
AI_PROVIDER="auto"

# OpenRouter (recommended if you use OpenRouter models)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Gemini fallback
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.0-flash-lite-preview-02-05"

# APP_URL: public URL for headers/callbacks
APP_URL="MY_APP_URL"
